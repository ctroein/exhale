include README.md
include pyproject.toml
include MANIFEST.in
include run_exhale.py

recursive-include exhale *.py
recursive-include exhale/resources/icons *.png *.svg *.txt
recursive-include exhale/resources/linux *.desktop
recursive-include exhale/resources/licenses *
include exhale/resources/*.jpg
recursive-include exhale/resources/models *.json *.h5 *.pt

exclude .gitignore

prune .github
prune build
prune dist
prune packaging
prune exhale/resources/ui

global-exclude __pycache__ *.py[cod]
