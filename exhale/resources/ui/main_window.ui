                      <item><property name="text"><string>Pixels</string></property></item>
                      <item><property name="text"><string>Null-model normalized</string></property></item>
                      <item><property name="text"><string>Null-model percentile</string></property></item>
                     </widget></item>
                    </layout>
                   </item>
                   <item>
